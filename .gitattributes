# The sources stay as they are, with LF line ends on every system, so
# that SHA256SUMS.txt and verify.py agree after a checkout; everything
# else (programs, disk images, generated data, pictures) is bytes. The
# PowerShell scripts keep the line ends they have, as bytes too.
* -text
*.asm text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.inc text eol=lf
*.ps1 -text
.gitattributes text eol=lf
.gitignore text eol=lf
